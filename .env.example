# Configure these through the hosting provider's secret/environment settings.
# Do not store actual values in GitHub.
ERP_ENV=production
ERP_BIND=127.0.0.1
PORT=8765
ERP_PUBLIC_ORIGIN=https://erp.example.com
ERP_DB=/var/lib/satata/erp.sqlite3
# Exact address of the HTTPS reverse proxy; never use *.
ERP_TRUSTED_PROXY=127.0.0.1
# Required before the first production administrator is created.
ERP_SETUP_TOKEN=
# Preserve this key across deployments and restores.
ERP_MFA_KEY=
# Separate encryption key for backups; preserve it separately from the archives.
ERP_BACKUP_KEY=
